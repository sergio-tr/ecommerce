{
  "name": "ecommerce",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "24.22.2",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "format:check": "nx format:check",
    "architecture": "nx run commercecore-catalog-domain:architecture",
    "secret-scan": "nx run ecommerce:secret-scan",
    "graph": "nx graph --file=tmp/nx-graph.json"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nx/eslint": "23.3.1",
    "@nx/eslint-plugin": "23.3.1",
    "@nx/js": "23.3.1",
    "@nx/nest": "23.3.1",
    "@nx/node": "23.3.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "nx": "23.3.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  },
  "nx": {
    "includedScripts": [],
    "projectType": "library",
    "tags": [
      "scope:workspace",
      "layer:tooling"
    ],
    "targets": {
      "secret-scan": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/security/scan-secrets.mjs"
        }
      }
    }
  }
}
