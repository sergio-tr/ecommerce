{
  "name": "egame-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/egame-web/src",
  "tags": ["scope:egame", "context:egame", "layer:app", "runtime:browser"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng build egame-web"
      }
    },
    "compile-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/egame-web/tsconfig.spec.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/egame-web/tsconfig.app.json --noEmit && tsc -p apps/egame-web/tsconfig.spec.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/egame-web --max-warnings=0"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile-tests"],
      "options": {
        "command": "node tools/run-node-tests.mjs dist/test/apps/egame-web"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng serve egame-web"
      }
    }
  }
}
